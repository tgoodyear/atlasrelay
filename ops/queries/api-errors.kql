// API failures, newest first: 5xx requests by function and status, and error log lines.
// Log lines written by api/src/lib/telemetry.ts are JSON; "Message" is the fixed sentence from
// the code and "Error" the error's class, code and status (never its message). 499 is a request
// the browser gave up on and is left out.
let requests = AppRequests
    | where toint(ResultCode) >= 500
    | summarize Count = sum(ItemCount), First = min(TimeGenerated), Latest = max(TimeGenerated)
        by Function = Name, Status = ResultCode
    | extend Source = "request", Message = "", Error = "";
let logs = AppTraces
    | where SeverityLevel >= 3
    | where Message !startswith "Executed '"
    | extend e = parse_json(iff(Message startswith "{", Message, "{}"))
    | extend Text = iff(isempty(tostring(e.message)), substring(Message, 0, 300), tostring(e.message))
    | summarize Count = count(), First = min(TimeGenerated), Latest = max(TimeGenerated)
        by Function = tostring(Properties.Category), Message = Text, Error = tostring(e.error)
    | extend Source = "log", Status = "";
union requests, logs
| project Latest, First, Source, Count, Function, Status, Message, Error
| order by Latest desc
