{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p e2e",
    "test": "node --test --import tsx test/seo.test.ts test/telemetry.test.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:flows": "playwright test -c playwright.flows.config.ts",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "e2e:stack": "node --import tsx e2e/flows/harness/stack.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@microsoft/applicationinsights-analytics-js": "^3.4.4",
    "@microsoft/applicationinsights-channel-js": "^3.4.4",
    "@microsoft/applicationinsights-core-js": "^3.4.4",
    "@microsoft/applicationinsights-dependencies-js": "^3.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@azure/data-tables": "^13.3.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jquery": "3.7.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
