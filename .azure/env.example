# An environment's settings, as scripts/bootstrap.sh writes them to .azure/<env>/.env (git-ignored).
# Read or change one with scripts/settings.sh <env> [KEY [VALUE]], then run scripts/provision.sh.
# The values below are placeholders.

# Set by scripts/bootstrap.sh. Change these by tearing the environment down and bootstrapping again.
AZURE_ENV_NAME="prod"
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_LOCATION="westus2"
ATLASRELAY_GITHUB_REPO="tgoodyear/atlasrelay"
ATLASRELAY_GITHUB_OIDC_SUBJECT_PREFIX="repo:OWNER@OWNER-ID/REPO@REPO-ID"

# Read by infra/main.bicepparam. Empty or missing takes the default there.
ATLASRELAY_ALERT_EMAIL="alerts@example.org"
ATLASRELAY_BUDGET_START="2026-10-01"
ATLASRELAY_DNS_ZONE="atlasrelay.org"
ATLASRELAY_DNS_TTL="3600"
ATLASRELAY_SWA_APEX_TOKEN=""
# Object id of the Owner who edits table rows by hand; scripts/bootstrap.sh sets it to whoever runs it.
ATLASRELAY_OPERATOR_PRINCIPAL_ID="00000000-0000-0000-0000-000000000000"
# Leave unset. ATLASRELAY_API_UNLINKED=true unlinks the API, only to relink it (docs/RUNBOOK.md,
# "Direct requests to the Function App"). ATLASRELAY_STORAGE_SHARED_KEY=true turns key access back on.
# ATLASRELAY_RESOURCE_GROUP_UNLOCKED=true leaves prod's CanNotDelete lock off for one deployment that
# deletes a resource (docs/RUNBOOK.md, "Changing infrastructure").
ATLASRELAY_STORAGE_SHARED_KEY=""
ATLASRELAY_API_UNLINKED=""
ATLASRELAY_RESOURCE_GROUP_UNLOCKED=""
# Client ids of the site's own sign-in registrations, written by scripts/register-signin.sh
# (docs/RUNBOOK.md, "Sign-in registrations"). Not secret. Empty: the built-in GitHub and Microsoft
# sign-in. The client secrets are in the environment's sign-in vault, never in this file.
ATLASRELAY_GITHUB_CLIENT_ID=""
ATLASRELAY_MICROSOFT_CLIENT_ID=""
ATLASRELAY_GOOGLE_CLIENT_ID=""
ATLASRELAY_ORCID_CLIENT_ID=""
# Written by scripts/provision.sh from the pairs above: the providers a build for this environment
# offers (VITE_SIGNIN_PROVIDERS). Empty: built-in GitHub and Microsoft.
SIGNIN_PROVIDERS=""

# Outputs of the stack, rewritten by every deployment.
AZURE_RESOURCE_GROUP="rg-atlasrelay-prod"
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
CI_CLIENT_ID="00000000-0000-0000-0000-000000000000"
CI_PRINCIPAL_ID="00000000-0000-0000-0000-000000000000"
SWA_NAME="swa-atlasrelay-prod"
SWA_HOSTNAME="example-name-0123456789.1.azurestaticapps.net"
SITE_HOSTNAME="atlasrelay.org"
SIGNIN_KEY_VAULT_NAME="kvs-atlasrelay-prod-abcd"
SIGNIN_IDENTITY_PRINCIPAL_ID="00000000-0000-0000-0000-000000000000"
STORAGE_ACCOUNT="statlasrelayprodabc123"
FUNCTION_APP_NAME="func-atlasrelay-prod-abc123"
FUNCTION_APP_HOSTNAME="func-atlasrelay-prod-abc123.azurewebsites.net"
FUNCTION_STORAGE_ACCOUNT="stfnatlasrelayprodabcd"
LOG_ANALYTICS_WORKSPACE="log-atlasrelay-prod"
APPINSIGHTS_NAME="appi-atlasrelay-prod"
APPLICATIONINSIGHTS_CONNECTION_STRING=""
NAME_SERVERS="ns1-00.azure-dns.com. ns2-00.azure-dns.net. ns3-00.azure-dns.org. ns4-00.azure-dns.info."
# Full-flow test harness outputs; empty in prod.
E2E_JOB_NAME="caj-atlasrelay-dev-e2e"
E2E_KEY_VAULT_NAME="kv-atlasrelay-dev-abc123"
E2E_RESULTS_ACCOUNT="stare2edevabc123"
E2E_RESULTS_CONTAINER="results"
E2E_LOG_WORKSPACE_ID="00000000-0000-0000-0000-000000000000"
E2E_REGISTRY="cratlasrelaydevabc123"
